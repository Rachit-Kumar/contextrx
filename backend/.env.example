# ContextRx — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

# ── Gemini API ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── AWS ───────────────────────────────────────────────────
AWS_REGION=ap-south-1
DYNAMODB_TABLE_NAME=PatientRecords
# AWS credentials are read from ~/.aws/credentials (recommended)
# OR set them here (less secure — only for local dev):
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# ── Local dev toggle ──────────────────────────────────────
# Set to "true" to use local patients.json instead of DynamoDB
USE_LOCAL_JSON=true
